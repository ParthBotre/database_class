# Match your MySQL Workbench connection "db_project" (do not commit real .env).
#
# Workbench: Host 127.0.0.1, Port 3306, User root → use the same below.
# MYSQL_PASSWORD must be the password you use when Workbench opens that connection
# (Workbench stores it in the keychain; re-type it here for the Flask app).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=VideoPlatform

# Only if Python reports SSL/handshake errors to localhost; leave unset normally.
# MYSQL_SSL_DISABLED=true

# Railway: on the web service, set MYSQL_URL to ${{ MySQL.MYSQL_URL }} (do not paste the URL into git).
# If the URL’s database segment is "railway" but your schema is in VideoPlatform, also set MYSQL_DATABASE=VideoPlatform.
# Local dev: leave MYSQL_URL unset and use MYSQL_HOST / MYSQL_USER / ... above instead.
